# eSocial Rendimentos SaaS Configuration
# Ambiente de Desenvolvimento

# Application
APP_NAME="eSocial Rendimentos SaaS"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/esocial_saas"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (Celery & Cache)
REDIS_URL="redis://localhost:6379/0"

# Security
SECRET_KEY="your-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Multi-tenancy
TENANT_HEADER="X-Tenant-ID"
DEFAULT_TENANT="default"

# Storage
STORAGE_TYPE="local"  # local, s3, gcs
STORAGE_PATH="/tmp/esocial-storage"
MAX_UPLOAD_SIZE_MB=50

# eSocial
ESOCIAL_VERSION="S-1.3"
ESOCIAL_AMBIENTE="PRODUCAO"  # PRODUCAO or PRE_PRODUCACAO

# PDF Generation
PDF_GENERATOR="reportlab"
PDF_WATERMARK=False

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"  # json or text

# Monitoring
PROMETHEUS_ENABLED=True
METRICS_PATH="/metrics"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
